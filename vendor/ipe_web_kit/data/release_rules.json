{
  "_note": "릴리즈노트 작성 규칙 값(RELEASE_NOTES_GUIDE). 코드를 안 고치고 금지어·길이·항목 수를 바꾼다. releases.py lint 가 읽는다.",
  "required_langs": ["ko", "en"],
  "items": {"min": 3, "max": 6},
  "max_chars": {"ko": 100, "en": 200, "default": 200},
  "fix_prefix": {"ko": "수정:", "en": "Fixed:"},
  "statuses": ["testflight", "store", "prep"],
  "site_extra_statuses": ["beta", "live"],
  "internal_words": {
    "substr": ["커밋", "브랜치", "리팩터", "리팩토링", "체크섬", "TestFlight 빌드", "테스트플라이트 빌드"],
    "word": ["refactor", "refactoring", "flutter", "TODO", "FIXME", "commit", "branch", "pull request"],
    "regex": ["\\bPR\\s*#?\\d+", "\\.dart\\b", "\\blib/", "\\b(?=[0-9a-f]*\\d)(?=[0-9a-f]*[a-f])[0-9a-f]{7,40}\\b"]
  },
  "hype_words": {
    "substr": ["최고", "완벽", "혁신", "획기적", "대폭"],
    "word": ["best ever", "perfect", "revolutionary", "groundbreaking", "amazing"]
  },
  "ko_endings": ["요.", "니다.", "요!", "니다!"],
  "push_blackout": ["10:00-11:00", "13:00-14:30"],
  "bundle_keep": 20
}
